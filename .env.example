# ============================================================
#  楽天ウェブサービス https://webservice.rakuten.co.jp/ の管理画面から取得
#  2026年のインフラ刷新以降、applicationId と accessKey の2点が必須。
#  片方だけでは 400 wrong_parameter で弾かれる。
# ============================================================

# 管理画面の「アプリケーションID」(UUID形式)
RAKUTEN_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# 管理画面の「アクセスキー」(伏字表示になっている値)
# ※規約 第5条2項により他人に知られないよう管理すること
RAKUTEN_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理画面の「アフィリエイトID」。これが無いと成果が自分に紐付かない
RAKUTEN_AFFILIATE_ID=abcdef01.23456789.abcdef02.3456789a

# 公開先URL(末尾スラッシュなし)。GitHub Pages なら https://<user>.github.io/<repo>
SITE_BASE_URL=https://example.github.io/uresuji-navi
